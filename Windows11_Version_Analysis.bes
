<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Analysis>
    <Title>Windows 11 Version Inventory</Title>
    <Description>
      Windows 11 release version inventory (21H2 through 26H2)
    </Description>

    <Property Name="Windows 11 Version" ID="{11111111-1111-1111-1111-111111111111}" EvaluationPeriod="PT12H">
      <Relevance>
if name of operating system starts with "Win11" then
(
  if exists value "DisplayVersion"
  of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion"
  of native registry
  then
  value "DisplayVersion"
  of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion"
  of native registry
  else "Unknown"
)
else "Not Windows 11"
      </Relevance>
    </Property>

    <Property Name="Windows 11 Build Number" ID="{22222222-2222-2222-2222-222222222222}" EvaluationPeriod="PT12H">
      <Relevance>
if name of operating system starts with "Win11"
then value "CurrentBuild"
of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion"
of native registry
else "N/A"
      </Relevance>
    </Property>

    <Property Name="Windows 11 Release" ID="{33333333-3333-3333-3333-333333333333}" EvaluationPeriod="PT12H">
      <Relevance>
if exists value "DisplayVersion"
of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion"
of native registry
then
value "DisplayVersion"
of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion"
of native registry
else "Unknown"
      </Relevance>
    </Property>

  </Analysis>
</BES>
