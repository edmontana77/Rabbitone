# Copy this file to .env and fill in real values. Never commit .env.

# --- This API's own server ---
PORT=3000
# Required. Clients must send this as: Authorization: Bearer <API_KEY>
API_KEY=change-me

# --- BigFix Inventory REST API connection ---
# Base URL of the BigFix Inventory REST API, including version path.
# Default install listens on port 9081. Adjust host/port for your environment.
BIGFIX_INVENTORY_BASE_URL=https://bigfix-inventory.example.com:9081/api/v1

# Auth option 1 (preferred for automated sync): a personal API token.
# Get it from BigFix Inventory UI: user icon > Profile > Show token.
BIGFIX_INVENTORY_TOKEN=

# Auth option 2: username/password (HTTP Basic). Used only if TOKEN is empty.
BIGFIX_INVENTORY_USERNAME=
BIGFIX_INVENTORY_PASSWORD=

# Set to "false" only for lab/self-signed servers. Keep "true" in production.
BIGFIX_INVENTORY_TLS_VERIFY=true

# --- Sync behavior ---
# Cron expression for automatic background sync. Empty disables the schedule
# (you can still trigger a sync manually via POST /api/sync).
SYNC_CRON=0 */6 * * *
# Page size used when paging through BigFix Inventory list endpoints.
SYNC_PAGE_SIZE=500
# Path to the local SQLite database file used to cache synced data.
DB_PATH=./data/bigfix.sqlite
