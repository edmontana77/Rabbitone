# Copy this file to .env and fill in your own values. Never commit the real .env file.

# --- Schedule ---
SCHEDULE_TIME=09:00
SCHEDULE_TIMEZONE=America/New_York
LOG_LEVEL=INFO

# --- Screener ---
PENNY_PRICE_FILTER=Under $5
PENNY_AVG_VOLUME_FILTER=Over 500K
PENNY_COUNTRY_FILTER=USA
PENNY_TOP_N=10
PENNY_MIN_PRICE=0.10

# --- Email (Gmail example: use an App Password, not your normal password) ---
EMAIL_ENABLED=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
EMAIL_SENDER=you@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_RECIPIENTS=you@gmail.com

# --- WhatsApp (via Twilio) ---
WHATSAPP_ENABLED=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Twilio's WhatsApp sandbox number, or your approved WhatsApp sender
TWILIO_WHATSAPP_FROM=+14155238886
# Your own WhatsApp number(s), comma-separated for multiple recipients
WHATSAPP_TO=+15551234567
